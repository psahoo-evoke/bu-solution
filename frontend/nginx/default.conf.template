# Rendered at container start: ${API_UPSTREAM} is replaced by envsubst; nginx's own $variables are left alone.
# Mirrors public/staticwebapp.config.json (SPA fallback + security headers) for the container deployment.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # API limit is 10 MB (backend/app/guard.py MAX_UPLOAD_BYTES) plus multipart overhead.
    client_max_body_size 12m;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Liveness probe for the web container itself (does not touch the API).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: the SPA calls relative /api/... (src/app/api/api.service.ts), so no CORS is needed.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # Container Apps internal ingress is HTTPS and routes by host name: send SNI + Host of the upstream.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Hashed bundles can be cached for a long time; index.html must not be.
    location ~* \.(?:js|css|woff2?|ico|png|svg|jpg|jpeg|gif|webp)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable" always;
    }

    # Deep links such as /review fall back to the SPA.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
